{
  "description": "SessionStart reminder of project GitHub sync and publication rules; does not execute Git synchronization.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/codex-sync-hook.py\"",
            "timeout": 90,
            "statusMessage": "Load project GitHub sync rules"
          }
        ]
      }
    ]
  }
}
